# Set these in the private runtime, never in a public repository.
# HTTPS issuer and application origin of the chosen OIDC provider/client:
OIDC_ISSUER_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PALACO_BASE_URL=
# Generate 32 random bytes as 64 hexadecimal characters:
PALACO_SESSION_SECRET=
# Absolute path to a private JSON membership file outside this repository:
PALACO_MEMBERS_FILE=
# Optional trusted reverse-proxy IP/CIDR list. Default is no proxy trust.
PALACO_TRUST_PROXY=
PORT=3000
NODE_ENV=production
