{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palaco.local/emerald/schemas/world-indexes.schema.json",
  "title": "Emerald Dual Indexes",
  "type": "object",
  "required": [
    "source_epoch",
    "canonical_name_index",
    "immutable_world_index"
  ],
  "properties": {
    "source_epoch": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "canonical_name_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonical_name",
          "world_id"
        ],
        "properties": {
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "world_id": {
            "type": "string",
            "pattern": "^EW-[0-9]{4,}$"
          }
        },
        "additionalProperties": false
      }
    },
    "immutable_world_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "world_id",
          "canonical_name"
        ],
        "properties": {
          "world_id": {
            "type": "string",
            "pattern": "^EW-[0-9]{4,}$"
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
