{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "palaco://schemas/PALACO_EVENT_V1",
  "title": "PALACO_EVENT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "source",
    "occurred_at",
    "received_at",
    "classification",
    "evidence",
    "provenance",
    "trace_id",
    "idempotency_key"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "minLength": 1 },
    "event_version": { "type": "string", "const": "1.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "connector", "object_type", "object_id"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "connector": { "type": "string", "minLength": 1 },
        "object_type": { "type": "string", "minLength": 1 },
        "object_id": { "type": "string", "minLength": 1 }
      }
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "actor": { "type": ["string", "null"] },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "category", "confidence", "priority"],
      "properties": {
        "domain": { "type": "string" },
        "category": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "priority": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"] },
          "kind": { "type": ["string", "null"] }
        }
      }
    },
    "context_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proposed_action": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["NONE", "REQUESTED", "GRANTED", "REJECTED", "REVOKED", "EXPIRED"]
        },
        "reference": { "type": ["string", "null"] }
      }
    },
    "execution": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref"],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1 },
        "parent_event_id": { "type": ["string", "null"] },
        "source_hash": { "type": ["string", "null"] }
      }
    },
    "trace_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 }
  }
}
