{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palaco:schemas:elixer-runtime-result-v0.1",
  "title": "elixer-runtime-result-v0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "resultId": {
      "type": "string",
      "format": "token64"
    },
    "correlationId": {
      "type": "string",
      "format": "token64"
    },
    "resultType": {
      "type": "string",
      "enum": [
        "READ_RESULT",
        "EXPLANATION",
        "PROPOSAL",
        "REVIEW_REQUIRED",
        "BLOCKED",
        "STALE",
        "EXPIRED",
        "REVOKED",
        "OFFLINE_READ_ONLY",
        "EXECUTION_PENDING_AUTHORIZATION",
        "EXECUTED_WITH_RECEIPT"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "elixerId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "packageDigest": {
          "type": [
            "string",
            "null"
          ],
          "format": "sha256"
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "tenantId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "worldId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "citadelId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "householdId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "required": [
        "elixerId",
        "version",
        "packageDigest",
        "actorId",
        "tenantId",
        "worldId",
        "citadelId"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "enum": [
            "UNRESOLVED",
            "RESOLVED",
            "INTEGRITY_VERIFIED"
          ]
        },
        "conformance": {
          "type": "string",
          "enum": [
            "NOT_RUN",
            "RUNNING",
            "PASS",
            "FAIL",
            "PARTIAL"
          ]
        },
        "authority": {
          "type": "string",
          "enum": [
            "NONE",
            "REVIEW_REQUIRED",
            "ISSUED_REFERENCE"
          ]
        },
        "distribution": {
          "type": "string",
          "enum": [
            "NOT_ALLOWED",
            "ALLOWED",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "activation": {
          "type": "string",
          "enum": [
            "INACTIVE",
            "CONSENT_REQUIRED",
            "ACTIVE",
            "DISABLED"
          ]
        },
        "freshness": {
          "type": "string",
          "enum": [
            "CURRENT",
            "STALE",
            "EXPIRED",
            "SUPERSEDED"
          ]
        },
        "execution": {
          "type": "string",
          "enum": [
            "NOT_REQUESTED",
            "AUTH_PENDING",
            "COMMITTED",
            "DENIED"
          ]
        }
      },
      "required": [
        "package",
        "conformance",
        "authority",
        "distribution",
        "activation",
        "freshness",
        "execution"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "evidence": {
      "type": "object",
      "properties": {
        "provenance": {
          "type": "string",
          "enum": [
            "BOUND_RECORDS",
            "UNKNOWN"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "INTEGRITY_ONLY",
            "NONE"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "provenance",
        "verification",
        "references"
      ],
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "GRANTED",
            "MISSING",
            "REVOKED",
            "EXPIRED",
            "UNKNOWN"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "reference"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_PROVIDED",
            "UNKNOWN",
            "DENIED",
            "GRANTED"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "reference"
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "personaResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "personaId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "characterVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": [
              "ADVISORY",
              "UNAVAILABLE"
            ]
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "READ_ONLY",
              "PAUSE"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "contextKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "required": [
          "personaId",
          "characterVersion",
          "status",
          "recommendation",
          "message",
          "contextKeys"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "personaId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "personaId",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    },
    "proposal": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "votes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "adoptedInternallyOnly": {
          "type": "boolean",
          "const": true
        },
        "grantsAuthority": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "recommendation",
        "votes",
        "adoptedInternallyOnly",
        "grantsAuthority"
      ],
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "format": "sha256"
        },
        "receiptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "required": [
        "sequence",
        "hash",
        "receiptId"
      ],
      "additionalProperties": false
    },
    "executionReceipt": {
      "description": "An immutable process-memory synthetic action receipt; no external side effect or durable audit claim.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.1"
        },
        "type": {
          "type": "string",
          "const": "SYNTHETIC_ACTION_RECEIPT"
        },
        "receiptId": {
          "type": "string",
          "format": "token64"
        },
        "actionDigest": {
          "type": "string",
          "format": "sha256"
        },
        "idempotencyKey": {
          "type": "string",
          "format": "token64"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "worldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "citadelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "elixerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "packageDigest": {
          "type": "string",
          "format": "sha256"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "consentReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "authorizationReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "const": "consumer.maintenance.apply"
        },
        "targetId": {
          "type": "string",
          "format": "token64"
        },
        "resourceType": {
          "type": "string",
          "enum": [
            "WEBSITE",
            "APP",
            "ELIXER"
          ]
        },
        "previousVersion": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "appliedVersion": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "committedAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventId": {
          "type": "string",
          "format": "token64"
        },
        "beforeDigest": {
          "type": "string",
          "format": "sha256"
        },
        "afterDigest": {
          "type": "string",
          "format": "sha256"
        },
        "commitStatus": {
          "type": "string",
          "const": "COMMITTED"
        },
        "storage": {
          "type": "string",
          "const": "PROCESS_MEMORY"
        },
        "externalSideEffect": {
          "type": "boolean",
          "const": false
        },
        "hash": {
          "type": "string",
          "format": "sha256"
        },
        "householdReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "householdDigest": {
          "type": "string",
          "format": "sha256"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "receiptId",
        "actionDigest",
        "idempotencyKey",
        "actorId",
        "tenantId",
        "worldId",
        "citadelId",
        "elixerId",
        "version",
        "packageDigest",
        "policyVersion",
        "consentReference",
        "authorizationReference",
        "action",
        "targetId",
        "resourceType",
        "previousVersion",
        "appliedVersion",
        "committedAt",
        "eventId",
        "beforeDigest",
        "afterDigest",
        "commitStatus",
        "storage",
        "externalSideEffect",
        "hash",
        "householdReference",
        "householdDigest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "resultId",
    "correlationId",
    "resultType",
    "identity",
    "state",
    "scope",
    "evidence",
    "consent",
    "authorization",
    "uncertainty",
    "reasonCodes",
    "personaResults",
    "dissent",
    "proposal",
    "trace"
  ],
  "additionalProperties": false
}
