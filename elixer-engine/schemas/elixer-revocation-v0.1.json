{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palaco:schemas:elixer-revocation-v0.1",
  "title": "elixer-revocation-v0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "state": {
      "type": "string",
      "enum": [
        "CURRENT",
        "UNKNOWN"
      ]
    },
    "revokedRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "state",
    "revokedRefs",
    "checkedAt"
  ],
  "additionalProperties": false
}
