{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palaco:schemas:elixer-consent-v0.1",
  "title": "elixer-consent-v0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "citadelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "household.read"
        ]
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "actorId",
    "tenantId",
    "worldId",
    "citadelId",
    "scopes",
    "expiresAt",
    "revoked"
  ],
  "additionalProperties": false
}
