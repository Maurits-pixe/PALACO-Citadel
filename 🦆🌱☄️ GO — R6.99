XIV. 🔬 FIELD RECORD OBJECT

Conceptueel:

pub struct ConstitutionalFieldRecord {
    pub record_id: FieldRecordId,
    pub specimen_id: SpecimenId,
    pub context_id: ContextId,
    pub observer: ObserverReference,
    pub observed_at: Timestamp,
    pub evidence_root: EvidenceRoot,
