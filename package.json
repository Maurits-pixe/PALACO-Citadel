{
  "name": "palaco-citadel",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:rio && npm run test:server && npm run test:launcher && npm run test:browser",
    "test:rio": "node rio/conformance.mjs",
    "test:browser": "npm run build:launcher && npm run build && npm run build:bastion && playwright test",
    "test:server": "node --test server/*.test.js",
    "test:launcher": "node --test launcher-vue/src/*.test.js",
    "dev:bastion": "vite --config vite.bastion.config.mjs",
    "dev:react": "vite --config vite.config.mjs",
    "dev:launcher": "vite --config vite.launcher.config.mjs",
    "server:bastion": "node server/index.js",
    "db:migrate:bastion": "node server/migrate.js",
    "db:bootstrap:bastion": "node server/bootstrap.js",
    "db:provision:bastion": "node server/provision-operative.js",
    "build:bastion": "vite build --config vite.bastion.config.mjs",
    "build:launcher": "vite build --config vite.launcher.config.mjs",
    "test:incident-recovery": "node --test registration/recovery-inspector.test.mjs",
    "test:preview": "node --test registration/preview.test.mjs registration/registry.test.mjs registration/recovery-inspector.test.mjs atelier/wizard.test.mjs atelier/builder.test.mjs citadel-proof/proof.test.mjs",
    "test:preview:browser": "node --test registration/preview.browser.test.mjs",
    "test:rio:contact": "node --test rio/contact-readiness.test.mjs rio/brigade-evidence.test.mjs rio/reference-outbox.test.mjs rio/contact-preview/reference.test.mjs rio/encrypted-reference/client.test.mjs rio/encrypted-reference/opaque.test.mjs rio/encrypted-reference/recovery.test.mjs",
    "test:rio:contact:browser": "playwright test --config rio/contact-preview/playwright.config.mjs",
    "test:rio:encrypted:browser": "playwright test --config rio/encrypted-reference/playwright.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "dev": "npm run dev:launcher"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
